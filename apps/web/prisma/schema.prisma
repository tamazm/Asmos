// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

enum PlanTier {
  FREE
  STARTER
  GROWTH
  SCALE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum CampaignType {
  WHEEL
  SCRATCH_CARD
  FORM
}

enum CampaignStatus {
  DRAFT
  GENERATING
  ACTIVE
  PAUSED
  FAILED
}

enum VariantStatus {
  GENERATING
  ACTIVE
  ELIMINATED
  WINNER
}

enum RewardType {
  COUPON
  DISCOUNT_PERCENT
  DISCOUNT_FIXED
  FREE_SHIPPING
}

enum CampaignEventType {
  IMPRESSION
  INTERACTION
  SUBMISSION
  GIFT_CLAIMED
  DISMISSED
}

// A customer business — the tenant boundary for every other model.
model Account {
  id         String   @id @default(cuid())
  name       String
  industry   String?
  brandColor String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Onboarding profile fields (collected during lean onboarding step 1)
  ownerRole      String? // founder | marketer | developer | agency | other
  conversionGoal String? // email_capture | discount | contest | lead_gen
  monthlyTraffic String? // lt_1k | 1k_10k | 10k_100k | gt_100k
  emailPlatform  String? // klaviyo | mailchimp | omnisend | none | other

  consentGdprEnabled Boolean @default(true)
  consentCcpaEnabled Boolean @default(true)
  consentBannerText  String? @db.Text

  onboardingCompletedAt DateTime?

  aiGenerationsCount Int      @default(0)
  billingCycleStart  DateTime @default(now())

  webhookUrl     String? // outbound webhook endpoint
  webhookSecret  String? // HMAC-SHA256 signing secret (customer sets this, we sign with it)
  webhookEnabled Boolean @default(false)

  planTier           PlanTier           @default(FREE)
  subscriptionStatus SubscriptionStatus @default(TRIALING)
  stripeCustomerId   String?            @unique

  users         User[]
  websites      Website[]
  campaigns     Campaign[]
  invites       Invite[]
  notifications Notification[]
}

model User {
  id          String   @id @default(cuid())
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  clerkUserId String   @unique
  email       String
  name        String?
  role        UserRole @default(MEMBER)
  createdAt   DateTime @default(now())

  @@index([accountId])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

// A pending teammate invite — becomes a User once the invitee signs up and accepts.
model Invite {
  id         String       @id @default(cuid())
  accountId  String
  account    Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  email      String
  role       UserRole     @default(MEMBER)
  token      String       @unique
  status     InviteStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  acceptedAt DateTime?

  @@index([accountId])
}

// A site the customer has installed the widget on.
model Website {
  id                String    @id @default(cuid())
  accountId         String
  account           Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  url               String
  installVerified   Boolean   @default(false)
  installVerifiedAt DateTime?
  createdAt         DateTime  @default(now())

  campaigns Campaign[]

  @@index([accountId])
}

model Campaign {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  websiteId String
  website   Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  name            String
  type            CampaignType
  status          CampaignStatus @default(DRAFT)
  tournamentRound Int            @default(1)

  // Set once a customer manually declares a winner (Phase 3 A/B test flow).
  // When set, the widget always serves this variant regardless of trafficPercent splits.
  winningVariantId String?  @unique
  winningVariant   Variant? @relation("CampaignWinner", fields: [winningVariantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lastError         String? @db.Text
  generationContext Json?

  variants Variant[]         @relation("CampaignVariants")
  insights CampaignInsight[]

  @@index([accountId])
  @@index([websiteId])
}

// One design/copy/offer to test within a campaign. A campaign always has at least
// one variant (created as "Control" at publish time); additional variants turn it
// into an A/B test — see Variant Manager / Test Results pages.
model Variant {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation("CampaignVariants", fields: [campaignId], references: [id], onDelete: Cascade)

  name            String
  // Fixed-split traffic allocation across a campaign's variants (Phase 3 — no bandit yet).
  trafficPercent  Int           @default(100)
  isControl       Boolean       @default(false)
  status          VariantStatus @default(ACTIVE)
  tournamentRound Int           @default(1)

  // Popup builder output: design, form fields, targeting/trigger rules.
  // Kept as JSON rather than normalized tables — no querying needs beyond
  // "load config for this variant" until the bandit phase needs to compare
  // structured fields across variants.
  design     Json?
  formFields Json?
  targeting  Json?

  // Schema-driven popup generation output (lib/popupGeneration.ts).
  // testAxis is the single lever this variant tests — used by the bandit allocator
  // and PostHog to attribute conversion deltas without ambiguity.
  testAxis         String? // "trigger | friction | copy | layout | visual"
  popupSpec        Json?   // Structured AI popup spec (trigger, headline, subhead, cta, fields, design_tokens)
  generatedCode    String? @db.Text // AI-generated self-contained HTML/CSS popup code
  hypothesis       String? // One sentence: what this variant tests and why
  motivatingMetric String? // Plain-language motivating metric for dashboard display

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rewards     RewardRule[]
  leads       Lead[]
  events      CampaignEvent[]
  wonCampaign Campaign?       @relation("CampaignWinner")

  @@index([campaignId])
}

model RewardRule {
  id        String  @id @default(cuid())
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  label      String
  type       RewardType
  couponCode String?
  // Win probability weight for game-based popups (wheel/scratch card); ignored for plain forms.
  weight     Int        @default(1)

  createdAt DateTime @default(now())

  @@index([variantId])
}

// A captured name/email/phone submission from the widget.
model Lead {
  id        String  @id @default(cuid())
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  name  String?
  email String?
  phone String?

  consentGiven Boolean   @default(false)
  consentAt    DateTime?

  rewardClaimedCode String?

  createdAt DateTime @default(now())

  @@index([variantId])
}

// Simple counters for the Phase 1 analytics dashboard (impressions, conversions,
// emails captured). Full clickstream/behavioral event storage is Phase 2 (ClickHouse),
// not this table.
model CampaignEvent {
  id        String            @id @default(cuid())
  variantId String
  variant   Variant           @relation(fields: [variantId], references: [id], onDelete: Cascade)
  type      CampaignEventType
  createdAt DateTime          @default(now())

  @@index([variantId, type, createdAt])
}

// Periodic AI-generated performance review for a campaign (Phase 6 — see
// lib/insights.ts and /api/cron/insights). Distinct from the bandit's live
// traffic reallocation: this is the slow, explanatory layer that reads the
// bandit's results and occasionally proposes a new variant to test.
model CampaignInsight {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  summary          String @db.Text
  suggestedVariant Json?

  createdAt DateTime @default(now())

  @@index([campaignId, createdAt])
}

// In-app notification bell items
model Notification {
  id        String    @id @default(cuid())
  accountId String
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  title     String
  body      String    @db.Text
  href      String? // optional deep-link
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([accountId, createdAt])
}

// Pre-signup leads captured from the /analyze CRO scanner
model AnalyzeLead {
  id        String   @id @default(cuid())
  email     String
  storeUrl  String
  storeName String?
  industry  String?
  score     Int?
  grade     String?
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

model RateLimit {
  id        String   @id @default(cuid())
  ip        String   @unique
  count     Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())

  @@index([ip])
}
