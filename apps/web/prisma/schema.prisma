// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

enum PlanTier {
  FREE
  STARTER
  GROWTH
  SCALE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum CampaignType {
  WHEEL
  SCRATCH_CARD
  FORM
}

enum CampaignStatus {
  DRAFT
  GENERATING
  ACTIVE
  PAUSED
  FAILED
  // Soft-delete: used instead of an actual row delete once a campaign has
  // real history (leads captured, events recorded) worth keeping - see
  // DELETE handler in app/api/campaigns/[id]/route.ts. Hidden from the
  // campaigns list and never served by the widget, same as any non-ACTIVE
  // status, but the data survives.
  ARCHIVED
}

enum VariantStatus {
  GENERATING
  ACTIVE
  ELIMINATED
  WINNER
}

enum RewardType {
  COUPON
  DISCOUNT_PERCENT
  DISCOUNT_FIXED
  FREE_SHIPPING
  // A non-monetary/fixed prize (free gift, tote bag, sample, etc.) - has a
  // free-text label/description instead of a discount amount or code.
  GIFT
}

enum CampaignEventType {
  IMPRESSION
  INTERACTION
  SUBMISSION
  GIFT_CLAIMED
  DISMISSED
}

// A customer business - the tenant boundary for every other model.
model Account {
  id         String   @id @default(cuid())
  name       String
  industry   String?
  brandColor String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Onboarding profile fields (collected during lean onboarding step 1)
  ownerRole      String? // founder | marketer | developer | agency | other
  conversionGoal String? // email_capture | discount | contest | lead_gen

  // Conversion-goal target, set inline from the dashboard's Conversion Goal
  // card. targetCvr is stored in percentage points (30 = 30%), matching how
  // conversion rate is displayed everywhere else in the app rather than a
  // 0-1 fraction that every read site would have to remember to multiply.
  // Both stay null until the user sets a target; the card renders its setup
  // state in that case instead of inventing a goal.
  targetCvr      Float?
  goalTargetAt   DateTime?
  monthlyTraffic String? // lt_1k | 1k_10k | 10k_100k | gt_100k
  emailPlatform  String? // klaviyo | mailchimp | omnisend | none | other

  consentGdprEnabled Boolean @default(true)
  consentCcpaEnabled Boolean @default(true)
  consentBannerText  String? @db.Text

  onboardingCompletedAt DateTime?

  aiGenerationsCount Int      @default(0)
  billingCycleStart  DateTime @default(now())

  webhookUrl     String? // outbound webhook endpoint
  webhookSecret  String? // HMAC-SHA256 signing secret (customer sets this, we sign with it)
  webhookEnabled Boolean @default(false)

  // API-key connections for facade integrations (Klaviyo, Mailchimp, HubSpot,
  // Shopify, Zapier). Keyed by integration id: { [id]: { apiKey, connectedAt } }.
  // Storage only for now - no background job forwards leads to these yet.
  integrationCredentials Json?

  planTier           PlanTier           @default(FREE)
  subscriptionStatus SubscriptionStatus @default(TRIALING)
  stripeCustomerId   String?            @unique

  users                     User[]
  websites                  Website[]
  campaigns                 Campaign[]
  invites                   Invite[]
  notifications             Notification[]
  shopifyShop               ShopifyShop?
  integrationConnections    IntegrationConnection[]
}

model User {
  id          String   @id @default(cuid())
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  clerkUserId String   @unique
  email       String
  name        String?
  role        UserRole @default(MEMBER)
  createdAt   DateTime @default(now())

  @@index([accountId])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

// A pending teammate invite - becomes a User once the invitee signs up and accepts.
model Invite {
  id         String       @id @default(cuid())
  accountId  String
  account    Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  email      String
  role       UserRole     @default(MEMBER)
  token      String       @unique
  status     InviteStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  acceptedAt DateTime?

  @@index([accountId])
}

// A site the customer has installed the widget on.
model Website {
  id                String    @id @default(cuid())
  accountId         String
  account           Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  url               String
  installVerified   Boolean   @default(false)
  installVerifiedAt DateTime?
  createdAt         DateTime  @default(now())

  campaigns    Campaign[]
  storeProfile StoreProfile?
  shopifyShop  ShopifyShop?

  @@index([accountId])
}

/// What we actually understand about a merchant's store.
///
/// Before this existed, the entire output of /api/analyze - palette, typefaces,
/// imagery style, signature element, detected popup - lived in sessionStorage
/// through onboarding and was then dropped: the only brand columns anywhere
/// were Account.industry and Account.brandColor, two strings. It survived into
/// a campaign only because NewCampaignForm happened to spread the raw analyze
/// blob into generationContext, and evaluateKnockout explicitly discarded it
/// from round two onward. That is why generated popups got the store's name
/// right and nothing else.
///
/// Every field records where it came from and how confident we are, in
/// `sources`, so the generator can weight a measured palette differently from
/// an inferred brand voice - and so a field that failed extraction reads as
/// null rather than as a plausible-looking default.
model StoreProfile {
  id        String  @id @default(cuid())
  websiteId String  @unique
  website   Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  // ── What they sell (from the catalogue: products.json / Store API / JSON-LD)
  category      String? // "children's sleepwear", never "Ecommerce / Retail"
  subcategories String[] @default([])
  audience      String? // "parents of under-fives"
  priceBandMin  Int? // minor units (pence/cents)
  priceBandMax  Int?
  priceBandMedian Int?
  currency      String?
  productCount  Int?

  // ── How it looks (from the DOM, measured, not guessed)
  palette       Json? // [{ hex, areaShare, role }]
  typeDisplay   String?
  typeBody      String?
  buttonStyle   Json? // { radius, textTransform, letterSpacing, fontWeight, bg, fg }
  borderRadius  String?
  logoUrl       String?
  productImages String[] @default([]) // the store's own photography, ranked

  // ── How it sounds (the one place a model is the right tool)
  brandVoice      String?
  valueProps      String[] @default([])
  signatureDetail String?

  // ── Bookkeeping
  platform        String? // shopify | woocommerce | custom
  detectedPopup   Json?
  sources         Json? // per-field provenance + confidence
  confirmedByUser Boolean  @default(false)
  analyzedAt      DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Campaign {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  websiteId String
  website   Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  name            String
  type            CampaignType
  status          CampaignStatus @default(DRAFT)
  tournamentRound Int            @default(1)

  // Set once a customer manually declares a winner (Phase 3 A/B test flow).
  // When set, the widget always serves this variant regardless of trafficPercent splits.
  winningVariantId String?  @unique
  winningVariant   Variant? @relation("CampaignWinner", fields: [winningVariantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lastError         String? @db.Text
  generationContext Json?
  // Fine-grained progress within status=GENERATING (see generateCampaign.ts).
  // Null while queued/unset or once generation leaves the GENERATING state.
  generationStage   String?

  variants Variant[]         @relation("CampaignVariants")
  insights CampaignInsight[]
  rewards  RewardRule[]

  // Explicit stamp for the bandit's recompute throttle. It used to infer this
  // from max(variants.updatedAt), so once the allocation stabilised no row was
  // written, the clock stopped advancing, and every subsequent widget event ran
  // a full 4,000-sample Monte Carlo over every arm.
  allocationComputedAt DateTime?
  // When the knockout bracket was last evaluated. Replaces an
  // `impressions % 1000 === 0` check that ran a full-table count on every
  // impression and was racy at the boundary in both directions.
  lastEvaluatedAt      DateTime?

  @@index([accountId])
  @@index([websiteId])
}

// One design/copy/offer to test within a campaign. A campaign always has at least
// one variant (created as "Control" at publish time); additional variants turn it
// into an A/B test - see Variant Manager / Test Results pages.
model Variant {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation("CampaignVariants", fields: [campaignId], references: [id], onDelete: Cascade)

  name            String
  // Fixed-split traffic allocation across a campaign's variants (Phase 3 - no bandit yet).
  trafficPercent  Int           @default(100)
  isControl       Boolean       @default(false)
  status          VariantStatus @default(ACTIVE)
  tournamentRound Int           @default(1)
  // Consecutive knockout evaluations in which this arm's posterior probability
  // of being best sat below the elimination threshold. Requiring two in a row
  // means one unlucky window cannot end a variant on its own. Reset whenever
  // the arm climbs back above the threshold.
  eliminationStrikes Int        @default(0)

  // Popup builder output: design, form fields, targeting/trigger rules.
  // Kept as JSON rather than normalized tables - no querying needs beyond
  // "load config for this variant" until the bandit phase needs to compare
  // structured fields across variants.
  design     Json?
  formFields Json?
  targeting  Json?

  // Schema-driven popup generation output (lib/popupGeneration.ts).
  // testAxis is the single lever this variant tests - used by the bandit allocator
  // and PostHog to attribute conversion deltas without ambiguity.
  testAxis         String? // "trigger | friction | copy | layout | visual"
  popupSpec        Json?   // Structured AI popup spec (trigger, headline, subhead, cta, fields, design_tokens)
  generatedCode    String? @db.Text // AI-generated self-contained HTML/CSS popup code
  hypothesis       String? // One sentence: what this variant tests and why
  motivatingMetric String? // Plain-language motivating metric for dashboard display

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads       Lead[]
  events      CampaignEvent[]
  wonCampaign Campaign?       @relation("CampaignWinner")

  @@index([campaignId])
}

model RewardRule {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  label       String
  // Free-text grouping for the Rewards dashboard (e.g. "Welcome offers", "Holiday").
  category    String?
  description String?
  type        RewardType
  // Legacy single shared code - still supported, used when no CouponCode pool exists.
  couponCode  String?
  // Win probability weight for game-based popups (wheel/scratch card); ignored for plain forms.
  weight      Int        @default(1)

  // Generic redemption cap, independent of the CouponCode pool mechanism -
  // lets any reward type (not just COUPON) be "a fixed amount, not
  // unlimited" (e.g. "the first 200 free-shipping claims"). Null = unlimited.
  // redemptionsCount is incremented once per lead this reward is handed to
  // (see api/widget/leads/route.ts), regardless of type.
  maxRedemptions   Int?
  redemptionsCount Int  @default(0)

  // Lets a reward be paused (excluded from selection and from the
  // "campaign has an available reward" popup-eligibility check) without
  // deleting it or losing its redemption history - used by the rewards page
  // when editing/reassigning.
  active Boolean @default(true)

  couponCodes CouponCode[]
  leads       Lead[]

  createdAt DateTime @default(now())

  @@index([campaignId])
}

// A pool of individual, single-use codes for a RewardRule - imported via CSV,
// bulk-generated, or both. When present, claiming this reward hands out one
// unused code instead of the shared RewardRule.couponCode.
model CouponCode {
  id           String     @id @default(cuid())
  rewardRuleId String
  rewardRule   RewardRule @relation(fields: [rewardRuleId], references: [id], onDelete: Cascade)

  code   String
  usedAt DateTime?
  leadId String?
  lead   Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([rewardRuleId, code])
  @@index([rewardRuleId, usedAt])
}

// A captured name/email/phone submission from the widget.
model Lead {
  id        String  @id @default(cuid())
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  name  String?
  email String?
  phone String?

  consentGiven Boolean   @default(false)
  consentAt    DateTime?

  rewardClaimedCode String?

  // Which specific RewardRule this lead was granted (set alongside
  // rewardClaimedCode in api/widget/leads/route.ts) - needed to attribute
  // redemptions against non-coupon reward types (FREE_SHIPPING/GIFT/etc.)
  // that don't otherwise leave any per-lead row the way CouponCode does.
  rewardRuleId String?
  rewardRule   RewardRule? @relation(fields: [rewardRuleId], references: [id], onDelete: SetNull)

  // Shopify attribution (set by the orders/paid + customers/create webhooks —
  // see lib/inngest/shopifyWebhooks.ts). shopifyCustomerId is also the mapping
  // GDPR customers/redact uses to find this lead.
  shopifyCustomerId  String?
  becameCustomerAt   DateTime?
  firstOrderId       String?
  firstOrderAmount   Decimal?  @db.Decimal(12, 2)
  firstOrderCurrency String?
  firstOrderAt       DateTime?

  createdAt DateTime @default(now())

  claimedCoupons CouponCode[]

  @@index([variantId])
  @@index([rewardRuleId])
  @@index([shopifyCustomerId])
  @@index([email])
}

// Simple counters for the Phase 1 analytics dashboard (impressions, conversions,
// emails captured). Full clickstream/behavioral event storage is Phase 2 (ClickHouse),
// not this table.
//
// visitorId/details added for the AI popup variation roadmap (Phase 0): a
// first-party per-visitor id (set by widget.js, also used as the PostHog
// distinct_id - previously every visitor of a variant shared one synthetic
// id, which broke funnels/cohorts) plus flexible behavioral context (scroll
// depth, dismiss timing, funnel step reached, referrer/UTMs). Kept as JSON
// rather than a wide column set since this signal set is expected to grow
// (Phase 1: rage clicks, field-level abandonment, etc.) before it's worth
// promoting to a dedicated store.
model CampaignEvent {
  id        String            @id @default(cuid())
  variantId String
  variant   Variant           @relation(fields: [variantId], references: [id], onDelete: Cascade)
  type      CampaignEventType
  createdAt DateTime          @default(now())
  visitorId String?
  details   Json?

  @@index([variantId, type, createdAt])
  @@index([visitorId])
}

// Periodic AI-generated performance review for a campaign (Phase 6 - see
// lib/insights.ts and /api/cron/insights). Distinct from the bandit's live
// traffic reallocation: this is the slow, explanatory layer that reads the
// bandit's results and occasionally proposes a new variant to test.
model CampaignInsight {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  summary          String @db.Text
  suggestedVariant Json?

  createdAt DateTime @default(now())

  @@index([campaignId, createdAt])
}

// A Shopify shop that has installed the app. accountId is unique - one
// Account per shop; the tenant is auto-provisioned on first install, no
// Clerk sign-up involved (this is what "well integrated app" requires).
// accessToken is encrypted at rest - see src/lib/crypto.ts.
model ShopifyShop {
  id            String    @id @default(cuid())
  accountId     String    @unique
  account       Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  shopDomain    String    @unique // e.g. "example.myshopify.com"
  accessToken   String
  scope         String
  installedAt   DateTime  @default(now())
  uninstalledAt DateTime?

  // Expiring offline access tokens (Shopify deprecates permanent offline tokens;
  // public apps must use expiring ones by 2027-01-01). The offline access token
  // above now lives ~1h; refreshToken (encrypted) renews it for ~90d without a
  // merchant present. See lib/shopify/tenant.ts:getValidAccessTokenForShop.
  tokenExpiresAt        DateTime?
  refreshToken          String?
  refreshTokenExpiresAt DateTime?

  // Set when a merchant links this shop to their existing (Clerk-backed) Asmos
  // account via the top-frame connect flow (see /api/shopify/connect). Null =
  // still on the auto-provisioned throwaway account created at install. Drives
  // the "Connect your Asmos account" prompt in the embedded admin.
  linkedAt DateTime?

  // The Website that holds this shop's popups/campaigns. Set on install so
  // storefront config lookups (/api/widget/config?shop=) resolve to it.
  websiteId String?  @unique
  website   Website? @relation(fields: [websiteId], references: [id], onDelete: SetNull)

  @@index([shopDomain])
}

// In-app notification bell items
model Notification {
  id        String    @id @default(cuid())
  accountId String
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  title     String
  body      String    @db.Text
  href      String? // optional deep-link
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([accountId, createdAt])
}

// Pre-signup leads captured from the /analyze CRO scanner
model AnalyzeLead {
  id        String   @id @default(cuid())
  email     String
  storeUrl  String
  storeName String?
  industry  String?
  score     Int?
  grade     String?
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

model RateLimit {
  id        String   @id @default(cuid())
  ip        String   @unique
  count     Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())

  @@index([ip])
}

model SystemLog {
  id        String   @id @default(cuid())
  accountId String?
  level     String   @default("ERROR")
  message   String
  details   String?  @db.Text
  createdAt DateTime @default(now())
}

enum LearnedPatternStatus {
  DRAFT
  APPROVED
  REJECTED
}

// AI popup variation roadmap, Phase 4: candidate patterns mined across ALL
// accounts by the mine-cross-account-patterns cron (see
// lib/inngest/mineCrossAccountPatterns.ts) - e.g. "in the fashion/beauty
// category, popups with a 'premature_dismissal' pattern conclusively improve
// after switching the trigger axis, across N independent campaigns."
//
// Deliberately human-gated: rows are created as DRAFT and never
// auto-promoted. Only APPROVED rows get woven into the live system prompt
// (see popupGeneration.ts's getLearnedPatternsSection) - a bad pattern with
// a false-positive read would otherwise degrade every customer's popups at
// once, so a human reviews each candidate before it affects generation.
model LearnedPattern {
  id             String               @id @default(cuid())
  // testAxis/failurePattern are free strings (matching Variant.testAxis'
  // existing convention) rather than Prisma enums, mirroring the TS union
  // types (TestAxis, FailurePattern) they're drawn from in lib/popupGeneration.ts.
  testAxis       String
  failurePattern String
  category       String
  description    String               @db.Text
  sampleSize     Int
  status         LearnedPatternStatus @default(DRAFT)
  createdAt      DateTime             @default(now())
  reviewedAt     DateTime?
  reviewedBy     String?

  @@index([status])
}

// A real popup, scraped from a high-traffic live site, kept as design
// grounding for generation (see popupGeneration.ts's getScrapedExamplesSection).
//
// Unlike LearnedPattern above, there's no human-approval gate here: the sites
// fed into the scraper (lib/popupScraping.ts's POPUP_SCRAPE_FN, run by a
// local-only, gitignored script - never a deployed job) are hand-picked by a
// human to be popular, high-traffic stores, so a captured row is trusted the
// moment it exists. The only filter generation applies is `present` - a
// scrape that found no popup on the page has nothing useful to offer.
model ScrapedPopupExample {
  id            String   @id @default(cuid())
  sourceUrl     String
  // Host + path, lowercased, protocol/www/query/hash/trailing-slash stripped
  // (lib/popupScraping.ts's normalizeUrl) - the dedupe key, so scraping
  // https://Example.com/ twice (or with/without www, http vs https) doesn't
  // produce two rows or spend a second Browserless call on the same site.
  normalizedUrl String   @unique
  segment       String // raw label as scraped, e.g. "Retail"
  industry      String // normalized bucket (lib/popupScraping.ts's normalizeIndustry) - what generation matches on

  present       Boolean  @default(false)
  html          String?  @db.Text
  // Everything about the design itself, as one connected object - copy,
  // colour (by role: card background, CTA accent, headline text - not just a
  // flat palette), typography, shape, density, imagery - matching the shape
  // of lib/popupDna.ts's knobs so a scraped example is actually comparable to
  // a generated one. See ScrapedPopupDesign in lib/popupScraping.ts. Used to
  // be six separate flat columns (headline/subhead/ctaText/templateGuess/
  // layoutGuess/palette) with no connection between them - you could see a
  // popup had a blue palette and separately that it had a pill button, but
  // nothing said the button *was* the blue thing.
  design        Json?
  screenshot    String?  @db.Text // base64 data: URL, cropped to just the popup element

  scrapedAt     DateTime @default(now())

  @@index([industry, present])
}

enum IntegrationProvider {
  webhooks
  zapier
  make
  n8n
  slack
  discord
  teams
  klaviyo
  mailchimp
  hubspot
  mailgun
  twilio
}

model IntegrationConnection {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  provider IntegrationProvider
  enabled  Boolean  @default(true)

  // Non-secret config: endpoint URL, list id, from-address, etc.
  config Json @default("{}")

  // AES-256-GCM EncryptedSecret whose plaintext is a JSON secret bundle.
  // Never returned to the client in plaintext.
  credentials Json?

  // Which canonical events fire this connection (e.g. ["lead.captured"]).
  subscribedEvents String[] @default([])

  // Messaging providers (mailgun/twilio) only: array of
  // { event, delayMinutes, templateId }. Stored as JSON to keep v1 simple.
  rules Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries IntegrationDelivery[]
  templates  MessageTemplate[]

  @@unique([accountId, provider])
}

model IntegrationDelivery {
  id           String                @id @default(cuid())
  connectionId String
  connection   IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  event  String
  status String // "success" | "failed" | "skipped"
  detail String? @db.Text

  createdAt DateTime @default(now())

  @@index([connectionId, createdAt])
}

model MessageTemplate {
  id           String  @id @default(cuid())
  connectionId String
  connection   IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  name    String
  channel String            // "email" | "sms"
  subject String?           // email only
  body    String  @db.Text  // supports {{lead.name}}, {{reward.coupon_code}}, ...

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([connectionId])
}
