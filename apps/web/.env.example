# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string. For local dev: Neon, Supabase, or a local Postgres.
# After cloning, run: npx prisma migrate deploy
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/asmos

# ─── Auth (Clerk) ─────────────────────────────────────────────────────────────
# Create a free app at https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk redirect URLs — leave these as-is
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# ─── Auth bypass (local dev only) ────────────────────────────────────────────
# Set to "true" to skip Clerk entirely and use a hardcoded test user.
# NEVER set this in staging or production.
MOCK_AUTH=false
NEXT_PUBLIC_MOCK_AUTH=false

# ─── AI — Campaign generation & insights ─────────────────────────────────────
# At least one of these is needed for AI campaign generation (/campaigns/new)
# and the biweekly insights cron. Without both, the app falls back to a mock
# response in development and errors in production.
#
# Claude (preferred): https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
#
# Gemini (fallback): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Used to send reward emails and team invite emails.
# Get a key at https://resend.com → API Keys
# Optional: widget lead capture still works without it, email delivery silently skips.
RESEND_API_KEY=re_...

# ─── Analytics (PostHog) ─────────────────────────────────────────────────────
# Used for dashboard page views and widget behavioral event forwarding.
# Optional: all PostHog calls are no-ops when this is not set.
# Get a key at https://posthog.com → Project Settings → API Keys
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# PostHog Query API — used by the popup generation engine to read live
# per-variant analytics (impressions, conversion rate, dismiss rate) and compute
# significance_flag before generating new variants.
# Without these, the system gracefully falls back to Postgres CampaignEvent data.
# Get a Personal API Key at https://posthog.com → Account Settings → Personal API Keys
# Project ID: https://posthog.com → Project Settings → Project ID
POSTHOG_PERSONAL_API_KEY=phx_...
POSTHOG_PROJECT_ID=12345
# Optional override for the Query API host. The ingestion host above is
# normalized automatically for PostHog Cloud (eu.i -> eu, us.i -> us).
# POSTHOG_QUERY_HOST=https://eu.posthog.com

# AI popup variation roadmap (Phase 1): loads posthog-js (session replay,
# rage-click/dead-click detection) directly on merchant sites via widget.js,
# gated behind the existing consent banner. Off by default — this is a
# separate opt-in from NEXT_PUBLIC_POSTHOG_KEY above because it starts
# recording real visitor sessions on merchant sites, which has privacy/CSP
# implications beyond just having a PostHog project configured.
POSTHOG_SESSION_RECORDING_ENABLED=false

# ─── Inngest (Background Jobs & Autonomous Queues) ───────────────────────────
# For local dev: You don't need these keys. Just run `npx inngest-cli dev` in a separate terminal.
# For production: Get these keys from your Inngest dashboard.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# ─── Cron secret ─────────────────────────────────────────────────────────────
# Protects /api/cron/insights from unauthorized calls.
# Vercel Cron sends this as: Authorization: Bearer <CRON_SECRET>
# Set the same value in Vercel → Environment Variables.
# Generate with: openssl rand -hex 32
CRON_SECRET=


# ─── Browserless (website screenshot for /analyze) ───────────────────────────
# Real browser rendering for AI-powered CRO analysis.
# Free tier: 1,000 sessions/month. Sign up at https://browserless.io
BROWSERLESS_TOKEN=***

# ─── AWS Bedrock (Claude Haiku vision — primary AI for /analyze) ─────────────
# Uses your existing AWS credentials. Set region where Bedrock is enabled.
# Credentials auto-detected from ~/.aws/credentials or IAM role.
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=***
AWS_SECRET_ACCESS_KEY=***

# ─── Superadmin access (/superadmin, /admin, Tester Toolkit) ─────────────────
# Comma-separated list of emails allowed to see these internal tools.
# Empty/unset means nobody has access — fails closed.
SUPERADMINS=you@example.com,teammate@example.com

# ─── Shopify embedded app (Milestone B1) ──────────────────────────────────────
# OAuth + session-token auth for the embedded admin under /shopify-admin.
# See docs/superpowers/plans (or the plan referenced in the B1 commit) for
# the full design. src/lib/shopify/client.ts reads these.
#
# 1. https://partners.shopify.com → Apps → your app → Configuration
#    Client ID / Client secret are generated for you.
# 2. App URL: {SHOPIFY_APP_URL}/shopify-admin
# 3. Allowed redirection URL(s): {SHOPIFY_APP_URL}/api/shopify/callback
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Same value as SHOPIFY_API_KEY, exposed to the client for the
# <meta name="shopify-api-key"> tag App Bridge requires (not a secret — it's
# the public Client ID).
NEXT_PUBLIC_SHOPIFY_API_KEY=

# This app's public origin — no trailing slash. Used to derive both the
# shopify-api hostName and the OAuth callback/redirect URLs above.
# e.g. https://app.asmos.io (or your ngrok/tunnel URL for local dev)
SHOPIFY_APP_URL=

# Scopes are managed in shopify.app.toml now: all data scopes live under
# `optional_scopes` and are granted per-shop via managed install + the in-app
# "what you'll allow" toggles (App Bridge Scopes API). This env var only affects
# the legacy authorization-code /install path (src/lib/shopify/client.ts).
# write_script_tags is deliberately excluded — storefront delivery uses a theme
# app extension (extensions/asmos-popup), not the deprecated ScriptTag API.
SHOPIFY_SCOPES=read_products,read_orders,read_customers

# AES-256-GCM key ShopifyShop.accessToken is encrypted with before it's
# stored (src/lib/crypto.ts) — 32 bytes, base64-encoded.
# Generate with: openssl rand -base64 32
SHOPIFY_TOKEN_ENCRYPTION_KEY=

# Shopify Partner Dashboard -> App setup -> Distribution. Custom-distribution
# apps skip Shopify's App Store review, which matters if this needs to ship fast.
# SHOPIFY_APP_HANDLE=
